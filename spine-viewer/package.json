{
  "name": "toolbuddy-spine-viewer",
  "displayName": "Spine Animation Player",
  "description": "Preview Spine 3.7 and 3.8 export folders in VS Code.",
  "icon": "assets/toolbuddy-icon.png",
  "version": "1.0.1",
  "publisher": "toolbuddy",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:toolbuddySpineViewer.openFolder"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "toolbuddySpineViewer.openFolder",
        "title": "ToolBuddy: Open Spine Animation Player"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "toolbuddySpineViewer.openFolder",
          "when": "explorerResourceIsFolder && resourcePath in toolbuddySpineViewer.supportedFolders",
          "group": "navigation"
        }
      ]
    }
  },
  "homepage": "https://www.toolbuddy.io/spine-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/toolbuddy-io/code-extension.git"
  },
  "scripts": {
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2"
  },
  "license": "MIT",
  "keywords": [
    "spine",
    "spine viewer",
    "animation",
    "vscode"
  ],
  "files": [
    "src/**",
    "media/**",
    "vendor/**",
    "assets/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bugs": {
    "url": "https://github.com/toolbuddy-io/code-extension/issues"
  }
}
